<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <ExcludeByFile>**/Migrations/**/*.cs,**/*ModelSnapshot.cs,**/*.g.cs,**/*.designer.cs</ExcludeByFile>
          <Exclude>[*.Tests]*,[*]Microsoft.*,[*]System.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
