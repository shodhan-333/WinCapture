{
  "name": "wincapture-entra-spa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:azure": "node ../scripts/build-azure.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint --config frontend/eslint.config.js frontend/src Tests/frontend.Tests --max-warnings=0",
    "format:check": "cd .. && prettier --config frontend/.prettierrc.json --check \"frontend/src/**/*.{ts,tsx,css}\" \"Tests/frontend.Tests/**/*.{ts,tsx}\" frontend/eslint.config.js frontend/.prettierrc.json frontend/package.json frontend/tsconfig.json frontend/vite.config.ts frontend/vitest.config.ts frontend/index.html",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.23.0",
    "@azure/msal-react": "^5.7.1",
    "@tanstack/react-query": "^5.104.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
