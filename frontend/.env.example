# Leave blank when React, Angular, and the API share one Azure App Service origin.
# For a separate API origin, use its public HTTPS URL and configure API CORS.
VITE_API_BASE_URL=
# Public Entra application registration identifiers and redirect settings.
VITE_MSAL_CLIENT_ID=<SPA_OR_APP_REGISTRATION_CLIENT_ID>
VITE_MSAL_TENANT_ID=<TENANT_ID>
# Blank uses the current site origin at runtime; register that exact URI in Entra.
VITE_MSAL_REDIRECT_URI=
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=
# Delegated scope exposed by the WinCapture backend API.
VITE_MSAL_API_SCOPE=api://<API_CLIENT_ID>/access_as_user
# URL for the existing Angular albums experience.
# Blank uses /angular/albums on the current site origin.
VITE_ANGULAR_ALBUMS_URL=
